{
  "name": "doro-creator-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx packages/local-server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "agent": "tsx packages/agent-tools/src/index.ts",
    "cli": "tsx packages/cli/src/index.ts",
    "doctor": "tsx packages/cli/src/index.ts doctor",
    "test:browser": "tsx tests/browser-smoke.ts",
    "test:mcp": "tsx tests/mcp-smoke.ts",
    "test:render": "tsx tests/render-smoke.ts",
    "start": "tsx packages/local-server/src/index.ts --production"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/material-symbols-outlined": "5.3.9",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xmldom/xmldom": "0.9.12",
    "adm-zip": "0.6.1",
    "express": "5.1.0",
    "fontkit": "3.0.0",
    "gsap": "3.13.0",
    "hyperframes": "0.8.224",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/adm-zip": "0.5.7",
    "@types/express": "5.0.3",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.15.24",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "bun": "1.4.4",
    "tsx": "4.20.4",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "hyperframes": {
      "undici": "7.30.1"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doro-Social/doro-creator-toolkit.git"
  }
}
